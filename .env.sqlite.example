# Pinned SQLite configuration. Copy to .env.sqlite only when setting up this project.
# The active cipher-workbench-sqlite project already owns port 18081.
APP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=18081

# Build/load and verify FE/BE images before setting these pins. Old rollout digests
# are recorded in docs/SQLITE_COMPOSE.md; they do not include the current FE changes.
BACKEND_REVISION=9d22937682434bc8847ae53449f612716e0ef6b8
BACKEND_IMAGE=
FRONTEND_IMAGE=

DATABASE_URL=sqlite+aiosqlite:////data/cipher-history.sqlite3
# Browser-owned history; enable deliberately per deployment.
HISTORY_API_ENABLED=true
# Persist the same secret across restarts; never replace an existing runtime key.
# For a NEW installation generate 32 random bytes as 64 hex characters, e.g.:
# python3 -c 'import secrets; print(secrets.token_hex(32))'
HISTORY_PROFILE_SIGNING_KEY=
# false is for loopback HTTP development only; use true behind HTTPS.
HISTORY_COOKIE_SECURE=false
# Nginx proxies /api same-origin.
CORS_ALLOW_ORIGINS=

FRONTEND_CPUS=0.5
FRONTEND_MEMORY=128m
BACKEND_CPUS=1.0
BACKEND_MEMORY=512m

# Feature flags are preserved by reusing FRONTEND_IMAGE; this Compose does not rebuild FE.

# Hourly SQLite backup outside the database volume; keep 7 days.
SQLITE_BACKUP_DIRECTORY=./backups/sqlite/local
SQLITE_BACKUP_INTERVAL_SECONDS=3600
SQLITE_BACKUP_RETENTION_DAYS=7
SQLITE_BACKUP_UID=1000
SQLITE_BACKUP_GID=1000
