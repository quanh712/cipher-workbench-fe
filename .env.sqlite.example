# Pinned SQLite configuration. Copy to .env.sqlite only when setting up this project.
# The active cipher-workbench-sqlite project already owns port 18081.
APP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=18081

# Backend image built from the clean source revision below and smoke-verified.
BACKEND_REVISION=229c69d7c9af8413a780002b266bdb7651e79cb4
BACKEND_IMAGE=cipher-workbench-sqlite-backend@sha256:c3332dd77a66c98e6dacb28666332501b6946f6414a36283347d95dd232677ae
# FE commit 175219d (08/10/2026): real Hill/DES/RSA enabled; load the pinned image.
FRONTEND_IMAGE=cipher-workbench-frontend@sha256:21fd5f2e9ebcc2056d9abb64957b484779831cfbc7f5aab7bd11ab3975e23dd5

DATABASE_URL=sqlite+aiosqlite:////data/cipher-history.sqlite3
# Enable only for a local/internal history rehearsal; no authentication exists.
# Preserve the history read feature enabled on the existing local stack.
HISTORY_API_ENABLED=true
HISTORY_RETENTION_DAYS=30
# Nginx proxies /api same-origin.
CORS_ALLOW_ORIGINS=

FRONTEND_CPUS=0.5
FRONTEND_MEMORY=128m
BACKEND_CPUS=1.0
BACKEND_MEMORY=512m

# Feature flags are preserved by reusing FRONTEND_IMAGE; this Compose does not rebuild FE.

# Hourly SQLite backup outside the database volume; keep 7 days.
SQLITE_BACKUP_DIRECTORY=./backups/sqlite/local
SQLITE_BACKUP_INTERVAL_SECONDS=3600
SQLITE_BACKUP_RETENTION_DAYS=7
SQLITE_BACKUP_UID=1000
SQLITE_BACKUP_GID=1000
