# Copy to .env.deploy on the deployment host. Never deploy a moving branch.
APP_DOMAIN=cipher.example.com
APP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=8080

# FE and BE repositories are sibling directories by default.
BACKEND_CONTEXT=../caesar-cipher-be

FRONTEND_REVISION=replace-with-frontend-commit-sha
BACKEND_REVISION=c314fa87bb87ad42ea10cd4fd96889ca176bfe26
FRONTEND_IMAGE_TAG=local
BACKEND_IMAGE_TAG=c314fa8

# PostgreSQL is private to the Compose network. Use a strong URL-safe password;
# keep POSTGRES_PASSWORD and the password in DATABASE_URL identical.
POSTGRES_USER=cipher
POSTGRES_PASSWORD=replace-with-strong-url-safe-password
POSTGRES_DB=cipher_workbench
DATABASE_URL=postgresql+asyncpg://cipher:replace-with-strong-url-safe-password@db:5432/cipher_workbench
# API lịch sử không có xác thực; chỉ bật bằng override ở stack dev/nội bộ.
HISTORY_API_ENABLED=false
HISTORY_RETENTION_DAYS=30

FRONTEND_CPUS=0.5
FRONTEND_MEMORY=128m
BACKEND_CPUS=1.0
BACKEND_MEMORY=512m

# DES requires a Backend checkout with revision 31438eb (and migration 0003).
VITE_ENABLE_DES=false
