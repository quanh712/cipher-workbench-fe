# API calls always use relative /api paths. Vite proxies them to localhost:8000.
# Hill integration passes with BE 4505ef7. Enable after that Backend is deployed.
VITE_ENABLE_HILL=false

# DES uses labeled local fixtures only; keep disabled for normal releases.
VITE_ENABLE_DES_DEMO=false

# Enable real DES after deploying the pinned DES Backend; takes priority over demo.
VITE_ENABLE_DES=false
