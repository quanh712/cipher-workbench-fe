# API calls use relative /api paths. Set the Vite proxy target in .env.local.
# Running local stack: http://127.0.0.1:18081; SQLite rehearsal: http://127.0.0.1:18082.
# Standalone Backend on port 8000 (default):
BACKEND_DEV_URL=http://127.0.0.1:8000
# Hill integration passes with BE 4505ef7. Enable after that Backend is deployed.
VITE_ENABLE_HILL=false

# DES uses labeled local fixtures only; keep disabled for normal releases.
VITE_ENABLE_DES_DEMO=false

# Enable real DES after deploying the pinned DES Backend; takes priority over demo.
VITE_ENABLE_DES=false

# RSA calls the pinned Backend API (229c69d or compatible). Enable after integration checks.
VITE_ENABLE_RSA=false
